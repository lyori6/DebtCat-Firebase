# Replaces the headers in firebase.json. Pages, CSS and JS use the default
# (revalidate on every visit), so changes reach visitors right away.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/images/*
  Cache-Control: public, max-age=31536000

/assets/images/*
  Cache-Control: public, max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000

/assets/fonts/*
  Cache-Control: public, max-age=31536000
